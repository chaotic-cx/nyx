diff '--color=auto' -u a/grammars.nix b/grammars.nix
--- a/grammars.nix	2026-10-01 17:03:08.797301696 -0300
+++ b/grammars.nix	2026-10-01 17:07:25.763041620 -0300
@@ -19,9 +19,6 @@
     owner = builtins.elemAt match 0;
     repo = builtins.elemAt match 1;
   };
-  # If `use-grammars.only` is set, use only those grammars.
-  # If `use-grammars.except` is set, use all other grammars.
-  # Otherwise use all grammars.
   useGrammar = grammar:
     if languagesConfig ? use-grammars.only
     then builtins.elem grammar.name languagesConfig.use-grammars.only
@@ -30,8 +27,37 @@
     else true;
   grammarsToUse = builtins.filter useGrammar languagesConfig.grammar;
   gitGrammars = builtins.filter isGitGrammar grammarsToUse;
+  # Helper to fetch grammar source with metadata
+  fetchGrammarMeta = grammar:
+    let
+      gh = toGitHubFetcher grammar.source.git;
+      ft = builtins.fetchTree (
+        if isGitHubGrammar grammar then {
+          type = "github";
+          owner = gh.owner;
+          repo = gh.repo;
+          inherit (grammar.source) rev;
+        } else {
+          type = "git";
+          url = grammar.source.git;
+          inherit (grammar.source) rev;
+          ref = grammar.source.ref or "HEAD";
+          shallow = true;
+        }
+      );
+    in {
+      name = grammar.name;
+      type = if isGitHubGrammar grammar then "github" else "git";
+      owner = if isGitHubGrammar grammar then gh.owner else null;
+      repo = if isGitHubGrammar grammar then gh.repo else null;
+      url = if isGitHubGrammar grammar then null else grammar.source.git;
+      rev = grammar.source.rev;
+      subpath = grammar.source.subpath or null;
+      inherit (ft) narHash lastModified lastModifiedDate;
+    };
   buildGrammar = grammar: let
     gh = toGitHubFetcher grammar.source.git;
+    hasSubpath = builtins.hasAttr "subpath" grammar.source && grammar.source.subpath != null;
     sourceGit = builtins.fetchTree {
       type = "git";
       url = grammar.source.git;
@@ -58,7 +84,7 @@
 
       src = source;
       sourceRoot =
-        if builtins.hasAttr "subpath" grammar.source
+        if hasSubpath
         then "source/${grammar.source.subpath}"
         else "source";
 
@@ -103,6 +129,8 @@
         $STRIP $out/$SHARED_LIB
         runHook postFixup
       '';
+
+      passthru.__grammarMeta = fetchGrammarMeta grammar;
     };
   grammarsToBuild = builtins.filter includeGrammarIf gitGrammars;
   builtGrammars =
@@ -116,13 +144,6 @@
   overlaidGrammars =
     lib.pipe extensibleGrammars
     (builtins.map (overlay: grammar: grammar.extend overlay) grammarOverlays);
-  sharedLibExtension = stdenv.hostPlatform.extensions.sharedLibrary;
-  grammarLinks =
-    lib.mapAttrsToList
-    (name: artifact: "ln -s ${artifact}/${name}${sharedLibExtension} $out/${name}${sharedLibExtension}")
-    (lib.filterAttrs (n: v: lib.isDerivation v) overlaidGrammars);
+  grammarList = lib.mapAttrsToList (name: drv: drv.passthru.__grammarMeta) (lib.filterAttrs (_: v: lib.isDerivation v && v ? passthru.__grammarMeta) overlaidGrammars);
 in
-  runCommand "consolidated-helix-grammars" {} ''
-    mkdir -p $out
-    ${builtins.concatStringsSep "\n" grammarLinks}
-  ''
+  builtins.toJSON grammarList
